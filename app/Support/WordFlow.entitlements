<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Microphone capture while the dictation key is held. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- MLX loads dynamic libraries at runtime. The app is not sandboxed, so
	     no sandbox entitlements. Accessibility (for the hotkey tap and text
	     insertion) is a TCC grant, not an entitlement. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
